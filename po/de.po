msgid "Choose a file"
msgstr "Datei auswählen"

msgid "Choose files"
msgstr "Dateien auswählen"

msgid "Selected files: %s"
msgstr "Ausgewählte Dateien: %s"

msgid "Selected files"
msgstr "Ausgewählte Dateien"

msgid "Unable to read the selected options."
msgstr "Die ausgewählten Optionen können nicht gelesen werden."

msgid "Select at least one file."
msgstr "Wählen Sie mindestens eine Datei aus."

msgid "Choose a folder"
msgstr "Ordner auswählen"

msgid "Select folder"
msgstr "Ordner wählen"

msgid "The current folder will be returned."
msgstr "Der aktuelle Ordner wird zurückgegeben."

msgid "Save file"
msgstr "Datei speichern"

msgid "Save files"
msgstr "Dateien speichern"

msgid "Files to save"
msgstr "Zu speichernde Dateien"

msgid "Existing or repeated names receive numbered variants."
msgstr "Vorhandene oder doppelte Namen erhalten eine Nummer."

msgid "The selected folder will be used to save these files."
msgstr "Der ausgewählte Ordner wird zum Speichern dieser Dateien verwendet."

msgid "Save"
msgstr "Speichern"

msgid "File name"
msgstr "Dateiname"

msgid "Enter a name for the file to save."
msgstr "Geben Sie einen Namen für die zu speichernde Datei ein."

msgid "File name copied from the selection."
msgstr "Dateiname aus der Auswahl übernommen."

msgid "Enter a file name."
msgstr "Geben Sie einen Dateinamen ein."

msgid "Enter a file name without a folder path."
msgstr "Geben Sie einen Dateinamen ohne Ordnerpfad ein."

msgid "The file name is too long."
msgstr "Der Dateiname ist zu lang."

msgid "Unable to check the target file: %s"
msgstr "Die Zieldatei kann nicht überprüft werden: %s"

msgid "Unable to check the target file."
msgstr "Die Zieldatei kann nicht überprüft werden."

msgid "A folder with this name already exists."
msgstr "Ein Ordner mit diesem Namen ist bereits vorhanden."

msgid "A file named “%s” already exists. Replace it?"
msgstr "Eine Datei namens „%s“ ist bereits vorhanden. Ersetzen?"

msgid "Replace existing file?"
msgstr "Vorhandene Datei ersetzen?"

msgid "Replace"
msgstr "Ersetzen"

msgid "Unable to show the overwrite confirmation."
msgstr "Die Bestätigung zum Überschreiben kann nicht angezeigt werden."

msgid "Up"
msgstr "Nach oben"

msgid "Home"
msgstr "Persönlicher Ordner"

msgid "Places"
msgstr "Orte"

msgid "Recent"
msgstr "Zuletzt verwendet"

msgid "No recent files."
msgstr "Keine zuletzt verwendeten Dateien."

msgid "Unable to read recent files."
msgstr "Zuletzt verwendete Dateien können nicht gelesen werden."

msgid "Unable to read recent files: %s"
msgstr "Zuletzt verwendete Dateien können nicht gelesen werden: %s"

msgid "Desktop"
msgstr "Schreibtisch"

msgid "Documents"
msgstr "Dokumente"

msgid "Downloads"
msgstr "Downloads"

msgid "Music"
msgstr "Musik"

msgid "Pictures"
msgstr "Bilder"

msgid "Videos"
msgstr "Videos"

msgid "Bookmark folder"
msgstr "Ordner als Lesezeichen speichern"

msgid "Remove bookmark"
msgstr "Lesezeichen entfernen"

msgid "No places available"
msgstr "Keine Orte verfügbar"

msgid "Bookmark added."
msgstr "Lesezeichen hinzugefügt."

msgid "Bookmark removed."
msgstr "Lesezeichen entfernt."

msgid "Unable to save bookmarks."
msgstr "Lesezeichen können nicht gespeichert werden."

msgid "Loading folder…"
msgstr "Ordner wird geladen …"

msgid "Search files"
msgstr "Dateien durchsuchen"

msgid "Filter files"
msgstr "Dateien filtern"

msgid "MIME type filtering is unavailable on this system."
msgstr "Die MIME-Typ-Filterung ist auf diesem System nicht verfügbar."

msgid "Show hidden files"
msgstr "Versteckte Dateien anzeigen"

msgid "No file selected"
msgstr "Keine Datei ausgewählt"

msgid "Open"
msgstr "Öffnen"

msgid "Choose an absolute directory path."
msgstr "Wählen Sie einen absoluten Ordnerpfad."

msgid "File selected. Choose Open to return it."
msgstr "Datei ausgewählt. Wählen Sie „Öffnen“, um sie zu übernehmen."

msgid "Select a file first."
msgstr "Wählen Sie zuerst eine Datei aus."

msgid "This folder is empty."
msgstr "Dieser Ordner ist leer."

msgid "Unable to read this folder."
msgstr "Dieser Ordner kann nicht gelesen werden."

msgid "Unable to read this folder: %s"
msgstr "Dieser Ordner kann nicht gelesen werden: %s"

msgid "No matching files."
msgstr "Keine passenden Dateien gefunden."

msgid "Locations"
msgstr "Orte"

msgid "Refresh"
msgstr "Aktualisieren"

msgid "Checking storage locations…"
msgstr "Speicherorte werden geprüft …"

msgid "Storage locations are unavailable."
msgstr "Speicherorte sind nicht verfügbar."

msgid "Storage information is incomplete; mount actions are unavailable."
msgstr "Speicherinformationen sind unvollständig; Einhängeaktionen sind nicht verfügbar."

msgid "Storage information is incomplete; removable-volume actions are unavailable."
msgstr "Die Speicherinformationen sind unvollständig; Aktionen für Wechseldatenträger sind nicht verfügbar."

msgid "No removable volumes or mounted network locations."
msgstr "Keine Wechseldatenträger oder eingebundenen Netzwerkorte gefunden."

msgid "Storage locations are up to date."
msgstr "Speicherorte sind aktuell."

msgid "Unable to read storage locations."
msgstr "Speicherorte können nicht gelesen werden."

msgid "Storage service is unavailable."
msgstr "Der Speicherdienst ist nicht verfügbar."

msgid "Storage access was denied."
msgstr "Der Zugriff auf den Speicher wurde verweigert."

msgid "Storage service is busy."
msgstr "Der Speicherdienst ist ausgelastet."

msgid "Unable to start the storage operation."
msgstr "Der Speichervorgang kann nicht gestartet werden."

msgid "Storage operation accepted."
msgstr "Der Speichervorgang wurde angenommen."

msgid "Storage operation completed."
msgstr "Der Speichervorgang wurde abgeschlossen."

msgid "Storage operation was cancelled."
msgstr "Der Speichervorgang wurde abgebrochen."

msgid "Storage operation outcome is uncertain."
msgstr "Das Ergebnis des Speichervorgangs ist ungewiss."

msgid "Mounting volume…"
msgstr "Datenträger wird eingebunden …"

msgid "Unmounting location…"
msgstr "Speicherort wird ausgehängt …"

msgid "A storage operation is already in progress."
msgstr "Ein Speichervorgang läuft bereits."

msgid "Storage authorization was denied."
msgstr "Die Speicherberechtigung wurde verweigert."

msgid "Storage information is incomplete; refresh and try again."
msgstr "Die Speicherinformationen sind unvollständig. Aktualisieren Sie sie und versuchen Sie es erneut."

msgid "This storage device changed. Refresh and try again."
msgstr "Dieses Speichergerät wurde geändert. Aktualisieren Sie die Ansicht und versuchen Sie es erneut."

msgid "This filesystem is not supported for mounting."
msgstr "Dieses Dateisystem wird zum Einbinden nicht unterstützt."

msgid "This volume is already mounted."
msgstr "Dieser Datenträger ist bereits eingebunden."

msgid "This location is managed by another service."
msgstr "Dieser Speicherort wird von einem anderen Dienst verwaltet."

msgid "A mount location is unavailable."
msgstr "Ein Einhängeort ist nicht verfügbar."

msgid "Storage authorization is unavailable."
msgstr "Die Speicherberechtigung ist nicht verfügbar."

msgid "The storage operation failed."
msgstr "Der Speichervorgang ist fehlgeschlagen."

msgid "Mount"
msgstr "Einbinden"

msgid "Unmount"
msgstr "Aushängen"

msgid "Confirm unmount"
msgstr "Aushängen bestätigen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Connect to SFTP"
msgstr "Mit SFTP verbinden"

msgid "Hide SFTP form"
msgstr "SFTP-Formular ausblenden"

msgid "Server name or address"
msgstr "Servername oder Adresse"

msgid "Server address"
msgstr "Serveradresse"

msgid "Username (optional)"
msgstr "Benutzername (optional)"

msgid "Username"
msgstr "Benutzername"

msgid "Remote folder (optional)"
msgstr "Remote-Ordner (optional)"

msgid "Remote folder"
msgstr "Remote-Ordner"

msgid "Connect"
msgstr "Verbinden"

msgid "Enter a server name or address."
msgstr "Geben Sie einen Servernamen oder eine Adresse ein."

msgid "Confirm disconnect"
msgstr "Trennen bestätigen"

msgid "Disconnect"
msgstr "Trennen"

msgid "Network service is unavailable."
msgstr "Der Netzwerkdienst ist nicht verfügbar."

msgid "Unable to start the network operation."
msgstr "Der Netzwerkvorgang kann nicht gestartet werden."

msgid "Connecting to SFTP location…"
msgstr "Verbindung zum SFTP-Speicherort wird hergestellt …"

msgid "Disconnecting network location…"
msgstr "Netzwerkort wird getrennt …"

msgid "Network location disconnected."
msgstr "Netzwerkort wurde getrennt."

msgid "Network location connected."
msgstr "Netzwerkort wurde verbunden."

msgid "Network connection was cancelled."
msgstr "Netzwerkverbindung wurde abgebrochen."

msgid "Network operation outcome is uncertain."
msgstr "Der Ausgang des Netzwerkvorgangs ist ungewiss."

msgid "Check the server address and try again."
msgstr "Prüfen Sie die Serveradresse und versuchen Sie es erneut."

msgid "SFTP support is unavailable."
msgstr "SFTP-Unterstützung ist nicht verfügbar."

msgid "Unable to start the network mount service."
msgstr "Der Netzwerk-Einhängedienst kann nicht gestartet werden."

msgid "Could not connect to the SFTP server."
msgstr "Die Verbindung zum SFTP-Server ist fehlgeschlagen."

msgid "Could not disconnect the network location."
msgstr "Der Netzwerkort konnte nicht getrennt werden."

msgid "The network operation failed."
msgstr "Der Netzwerkvorgang ist fehlgeschlagen."

msgid "Port (default 22)"
msgstr "Port (Standard: 22)"

msgid "Port"
msgstr "Port"

msgid "Enter a valid port from 1 to 65535."
msgstr "Geben Sie einen gültigen Port zwischen 1 und 65535 ein."

msgid "Sort by name"
msgstr "Nach Name sortieren"

msgid "Name (ascending)"
msgstr "Name (aufsteigend)"

msgid "Name (descending)"
msgstr "Name (absteigend)"

msgid "Enter a file name or select a file."
msgstr "Geben Sie einen Dateinamen ein oder wählen Sie eine Datei aus."

msgid "This file name cannot be represented on this system."
msgstr "Dieser Dateiname kann auf diesem System nicht dargestellt werden."

msgid "No file with that name exists in this folder."
msgstr "Eine Datei mit diesem Namen ist in diesem Ordner nicht vorhanden."

msgid "Unable to check the selected file."
msgstr "Die ausgewählte Datei kann nicht überprüft werden."

msgid "File name entered. Choose Open to check it."
msgstr "Dateiname eingegeben. Wählen Sie Öffnen, um ihn zu prüfen."

msgid "New folder"
msgstr "Neuer Ordner"

msgid "Folder name"
msgstr "Ordnername"

msgid "Create"
msgstr "Erstellen"

msgid "Enter a folder name."
msgstr "Geben Sie einen Ordnernamen ein."

msgid "Use a folder name without slashes or dot components."
msgstr "Verwenden Sie einen Ordnernamen ohne Schrägstriche oder Punktkomponenten."

msgid "Folder name is too long."
msgstr "Der Ordnername ist zu lang."

msgid "Unable to create the folder."
msgstr "Der Ordner kann nicht erstellt werden."

msgid "An item with this name already exists."
msgstr "Eine Datei oder ein Ordner mit diesem Namen existiert bereits."

msgid "You do not have permission to create a folder here."
msgstr "Sie haben keine Berechtigung, hier einen Ordner zu erstellen."

msgid "This location is read-only."
msgstr "Dieser Speicherort ist schreibgeschützt."

msgid "There is not enough space to create a folder."
msgstr "Es ist nicht genug Speicherplatz vorhanden, um einen Ordner zu erstellen."

msgid "The current folder is no longer available."
msgstr "Der aktuelle Ordner ist nicht mehr verfügbar."

msgid "Folder created."
msgstr "Ordner erstellt."

msgid "Creating folder…"
msgstr "Ordner wird erstellt …"
