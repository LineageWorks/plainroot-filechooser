msgid "Choose a file"
msgstr "Выберите файл"

msgid "Choose files"
msgstr "Выберите файлы"

msgid "Selected files: %s"
msgstr "Выбранные файлы: %s"

msgid "Selected files"
msgstr "Выбранные файлы"

msgid "Unable to read the selected options."
msgstr "Не удалось прочитать выбранные параметры."

msgid "Select at least one file."
msgstr "Выберите хотя бы один файл."

msgid "Choose a folder"
msgstr "Выберите папку"

msgid "Select folder"
msgstr "Выбрать папку"

msgid "The current folder will be returned."
msgstr "Будет возвращена текущая папка."

msgid "Save file"
msgstr "Сохранить файл"

msgid "Save files"
msgstr "Сохранить файлы"

msgid "Files to save"
msgstr "Файлы для сохранения"

msgid "Existing or repeated names receive numbered variants."
msgstr "К существующим или повторяющимся именам добавится номер."

msgid "The selected folder will be used to save these files."
msgstr "Выбранная папка будет использоваться для сохранения этих файлов."

msgid "Save"
msgstr "Сохранить"

msgid "File name"
msgstr "Имя файла"

msgid "Enter a name for the file to save."
msgstr "Введите имя файла для сохранения."

msgid "File name copied from the selection."
msgstr "Имя файла взято из выбранного элемента."

msgid "Enter a file name."
msgstr "Введите имя файла."

msgid "Enter a file name without a folder path."
msgstr "Введите имя файла без пути к папке."

msgid "The file name is too long."
msgstr "Имя файла слишком длинное."

msgid "Unable to check the target file: %s"
msgstr "Не удалось проверить целевой файл: %s"

msgid "Unable to check the target file."
msgstr "Не удалось проверить целевой файл."

msgid "A folder with this name already exists."
msgstr "Папка с таким именем уже существует."

msgid "A file named “%s” already exists. Replace it?"
msgstr "Файл «%s» уже существует. Заменить его?"

msgid "Replace existing file?"
msgstr "Заменить существующий файл?"

msgid "Replace"
msgstr "Заменить"

msgid "Unable to show the overwrite confirmation."
msgstr "Не удалось показать подтверждение перезаписи."

msgid "Up"
msgstr "Вверх"

msgid "Home"
msgstr "Домашняя папка"

msgid "Places"
msgstr "Места"

msgid "Recent"
msgstr "Недавние"

msgid "Recently used"
msgstr "Недавно использованные"

msgid "No recent files."
msgstr "Недавних файлов нет."

msgid "Unable to read recent files."
msgstr "Не удалось прочитать недавние файлы."

msgid "Unable to read recent files: %s"
msgstr "Не удалось прочитать недавние файлы: %s"

msgid "Desktop"
msgstr "Рабочий стол"

msgid "Documents"
msgstr "Документы"

msgid "Downloads"
msgstr "Загрузки"

msgid "Music"
msgstr "Музыка"

msgid "Pictures"
msgstr "Изображения"

msgid "Videos"
msgstr "Видео"

msgid "Bookmark folder"
msgstr "Добавить папку в закладки"

msgid "Remove bookmark"
msgstr "Удалить закладку"

msgid "No places available"
msgstr "Нет доступных мест"

msgid "Bookmark added."
msgstr "Закладка добавлена."

msgid "Bookmark removed."
msgstr "Закладка удалена."

msgid "Unable to save bookmarks."
msgstr "Не удалось сохранить закладки."

msgid "Loading folder…"
msgstr "Загрузка папки…"

msgid "Checking link…"
msgstr "Проверка ссылки…"

msgid "This item is no longer available."
msgstr "Этот объект больше недоступен."

msgid "This item cannot be selected here."
msgstr "Этот объект нельзя выбрать здесь."

msgid "Search files"
msgstr "Поиск файлов"

msgid "Filter files"
msgstr "Фильтр файлов"

msgid "MIME type filtering is unavailable on this system."
msgstr "Фильтрация по типу MIME недоступна в этой системе."

msgid "Show hidden files"
msgstr "Показывать скрытые файлы"

msgid "No file selected"
msgstr "Файл не выбран"

msgid "Open"
msgstr "Открыть"

msgid "Choose an absolute directory path."
msgstr "Укажите абсолютный путь к папке."

msgid "File selected. Choose Open to return it."
msgstr "Файл выбран. Нажмите «Открыть», чтобы подтвердить выбор."

msgid "Select a file first."
msgstr "Сначала выберите файл."

msgid "This folder is empty."
msgstr "Эта папка пуста."

msgid "Unable to read this folder."
msgstr "Не удалось прочитать эту папку."

msgid "Unable to read this folder: %s"
msgstr "Не удалось прочитать эту папку: %s"

msgid "No matching files."
msgstr "Подходящие файлы не найдены."

msgid "Locations"
msgstr "Расположения"

msgid "Refresh"
msgstr "Обновить"

msgid "Checking storage locations…"
msgstr "Проверка мест хранения…"

msgid "Storage locations are unavailable."
msgstr "Места хранения недоступны."

msgid "Storage information is incomplete; mount actions are unavailable."
msgstr "Сведения о хранилище неполные; операции подключения недоступны."

msgid "Storage information is incomplete; removable-volume actions are unavailable."
msgstr "Сведения о хранилище неполные; действия со съёмными томами недоступны."

msgid "No removable volumes or mounted network locations."
msgstr "Нет съёмных томов или подключённых сетевых расположений."

msgid "Storage locations are up to date."
msgstr "Сведения о местах хранения обновлены."

msgid "Unable to read storage locations."
msgstr "Не удалось прочитать места хранения."

msgid "Storage service is unavailable."
msgstr "Служба хранения недоступна."

msgid "Storage access was denied."
msgstr "В доступе к хранилищу отказано."

msgid "Storage service is busy."
msgstr "Служба хранения занята."

msgid "Unable to start the storage operation."
msgstr "Не удалось запустить операцию с хранилищем."

msgid "Storage operation accepted."
msgstr "Запрос операции с хранилищем принят."

msgid "Storage operation completed."
msgstr "Операция с хранилищем завершена."

msgid "Storage operation was cancelled."
msgstr "Операция с хранилищем отменена."

msgid "Storage operation outcome is uncertain."
msgstr "Результат операции с хранилищем неизвестен."

msgid "Mounting volume…"
msgstr "Подключение тома…"

msgid "Unmounting location…"
msgstr "Отключение расположения…"

msgid "A storage operation is already in progress."
msgstr "Операция с хранилищем уже выполняется."

msgid "Storage authorization was denied."
msgstr "В разрешении на доступ к хранилищу отказано."

msgid "Storage information is incomplete; refresh and try again."
msgstr "Сведения о хранилище неполные. Обновите их и попробуйте снова."

msgid "This storage device changed. Refresh and try again."
msgstr "Это устройство хранения изменилось. Обновите данные и попробуйте снова."

msgid "This filesystem is not supported for mounting."
msgstr "Подключение этой файловой системы не поддерживается."

msgid "This volume is already mounted."
msgstr "Этот том уже подключён."

msgid "This location is managed by another service."
msgstr "Это расположение управляется другой службой."

msgid "A mount location is unavailable."
msgstr "Точка подключения недоступна."

msgid "Storage authorization is unavailable."
msgstr "Авторизация доступа к хранилищу недоступна."

msgid "The storage operation failed."
msgstr "Не удалось выполнить операцию с хранилищем."

msgid "Mount"
msgstr "Подключить"

msgid "Unmount"
msgstr "Отключить"

msgid "Confirm unmount"
msgstr "Подтвердить отключение"

msgid "Cancel"
msgstr "Отмена"

msgid "Connect to SFTP"
msgstr "Подключиться по SFTP"

msgid "Hide SFTP form"
msgstr "Скрыть форму SFTP"

msgid "Server name or address"
msgstr "Имя или адрес сервера"

msgid "Server address"
msgstr "Адрес сервера"

msgid "Username (optional)"
msgstr "Имя пользователя (необязательно)"

msgid "Username"
msgstr "Имя пользователя"

msgid "Remote folder (optional)"
msgstr "Удалённая папка (необязательно)"

msgid "Remote folder"
msgstr "Удалённая папка"

msgid "Connect"
msgstr "Подключить"

msgid "Enter a server name or address."
msgstr "Введите имя или адрес сервера."

msgid "Confirm disconnect"
msgstr "Подтвердить отключение"

msgid "Disconnect"
msgstr "Отключить"

msgid "Network service is unavailable."
msgstr "Сетевая служба недоступна."

msgid "Unable to start the network operation."
msgstr "Не удалось запустить сетевую операцию."

msgid "Connecting to SFTP location…"
msgstr "Подключение к расположению SFTP…"

msgid "Disconnecting network location…"
msgstr "Отключение сетевого расположения…"

msgid "Network location disconnected."
msgstr "Сетевое расположение отключено."

msgid "Network location connected."
msgstr "Сетевое расположение подключено."

msgid "Network connection was cancelled."
msgstr "Подключение к сети отменено."

msgid "Network operation outcome is uncertain."
msgstr "Результат сетевой операции неизвестен."

msgid "Check the server address and try again."
msgstr "Проверьте адрес сервера и попробуйте снова."

msgid "SFTP support is unavailable."
msgstr "Поддержка SFTP недоступна."

msgid "Unable to start the network mount service."
msgstr "Не удалось запустить службу сетевого монтирования."

msgid "Could not connect to the SFTP server."
msgstr "Не удалось подключиться к серверу SFTP."

msgid "The network location could not be mounted. Check the server, host key, login, and FUSE availability."
msgstr "Не удалось подключить сетевое расположение. Проверьте сервер, ключ узла, способ входа и доступность FUSE."

msgid "Could not disconnect the network location."
msgstr "Не удалось отключить сетевое расположение."

msgid "The network operation failed."
msgstr "Сетевая операция завершилась ошибкой."

msgid "Port (default 22)"
msgstr "Порт (по умолчанию 22)"

msgid "Port"
msgstr "Порт"

msgid "Enter a valid port from 1 to 65535."
msgstr "Введите допустимый номер порта от 1 до 65535."

msgid "Sort by name"
msgstr "Сортировать по имени"

msgid "Name (ascending)"
msgstr "Имя (по возрастанию)"

msgid "Name (descending)"
msgstr "Имя (по убыванию)"

msgid "Enter a file name or select a file."
msgstr "Введите имя файла или выберите файл."

msgid "This file name cannot be represented on this system."
msgstr "Это имя файла нельзя представить в этой системе."

msgid "No file with that name exists in this folder."
msgstr "В этой папке нет файла с таким именем."

msgid "Unable to check the selected file."
msgstr "Не удалось проверить выбранный файл."

msgid "File name entered. Choose Open to check it."
msgstr "Имя файла введено. Нажмите «Открыть», чтобы проверить его."

msgid "New folder"
msgstr "Новая папка"

msgid "Folder name"
msgstr "Имя папки"

msgid "Create"
msgstr "Создать"

msgid "Enter a folder name."
msgstr "Введите имя папки."

msgid "Use a folder name without slashes or dot components."
msgstr "Введите имя папки без косых черт и компонентов «.» или «..»."

msgid "Folder name is too long."
msgstr "Имя папки слишком длинное."

msgid "Unable to create the folder."
msgstr "Не удалось создать папку."

msgid "An item with this name already exists."
msgstr "Файл или папка с таким именем уже существует."

msgid "You do not have permission to create a folder here."
msgstr "У вас нет разрешения создавать папки в этом месте."

msgid "This location is read-only."
msgstr "Это расположение доступно только для чтения."

msgid "Open files read-only"
msgstr "Открывать файлы только для чтения"

msgid "There is not enough space to create a folder."
msgstr "Недостаточно места для создания папки."

msgid "The current folder is no longer available."
msgstr "Текущая папка больше недоступна."

msgid "Folder created."
msgstr "Папка создана."

msgid "Creating folder…"
msgstr "Создание папки…"
