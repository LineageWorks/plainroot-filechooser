msgid "Choose a file"
msgstr "اختر ملفًا"

msgid "Choose files"
msgstr "اختر ملفات"

msgid "Selected files: %s"
msgstr "الملفات المحددة: %s"

msgid "Selected files"
msgstr "الملفات المحددة"

msgid "Select at least one file."
msgstr "اختر ملفًا واحدًا على الأقل."

msgid "Choose a folder"
msgstr "اختر مجلدًا"

msgid "Select folder"
msgstr "اختيار المجلد"

msgid "The current folder will be returned."
msgstr "سيتم إرجاع المجلد الحالي."

msgid "Save file"
msgstr "حفظ الملف"

msgid "Save"
msgstr "حفظ"

msgid "File name"
msgstr "اسم الملف"

msgid "Enter a name for the file to save."
msgstr "أدخل اسمًا للملف المراد حفظه."

msgid "File name copied from the selection."
msgstr "تم نسخ اسم الملف من العنصر المحدد."

msgid "Enter a file name."
msgstr "أدخل اسم الملف."

msgid "Enter a file name without a folder path."
msgstr "أدخل اسم الملف دون مسار مجلد."

msgid "The file name is too long."
msgstr "اسم الملف طويل جدًا."

msgid "Unable to check the target file: %s"
msgstr "تعذر التحقق من الملف الهدف: %s"

msgid "Unable to check the target file."
msgstr "تعذر التحقق من الملف الهدف."

msgid "A folder with this name already exists."
msgstr "يوجد مجلد بهذا الاسم بالفعل."

msgid "A file named “%s” already exists. Replace it?"
msgstr "يوجد ملف باسم «%s» بالفعل. هل تريد استبداله؟"

msgid "Replace existing file?"
msgstr "استبدال الملف الموجود؟"

msgid "Replace"
msgstr "استبدال"

msgid "Unable to show the overwrite confirmation."
msgstr "تعذر عرض تأكيد الاستبدال."

msgid "Up"
msgstr "أعلى"

msgid "Home"
msgstr "المجلد الرئيسي"

msgid "Loading folder…"
msgstr "جارٍ تحميل المجلد…"

msgid "Search files"
msgstr "البحث في الملفات"

msgid "Filter files"
msgstr "تصفية الملفات"

msgid "MIME type filters are not applied yet."
msgstr "لم تُطبّق فلاتر نوع MIME بعد."

msgid "Show hidden files"
msgstr "إظهار الملفات المخفية"

msgid "No file selected"
msgstr "لم يتم تحديد ملف"

msgid "Open"
msgstr "فتح"

msgid "Choose an absolute directory path."
msgstr "اختر مسارًا مطلقًا للمجلد."

msgid "File selected. Choose Open to return it."
msgstr "تم تحديد الملف. اختر «فتح» لتأكيده."

msgid "Select a file first."
msgstr "حدّد ملفًا أولًا."

msgid "This folder is empty."
msgstr "هذا المجلد فارغ."

msgid "Unable to read this folder."
msgstr "تعذّر قراءة هذا المجلد."

msgid "Unable to read this folder: %s"
msgstr "تعذّر قراءة هذا المجلد: %s"

msgid "No matching files."
msgstr "لم يتم العثور على ملفات مطابقة."

msgid "Locations"
msgstr "المواقع"

msgid "Refresh"
msgstr "تحديث"

msgid "Checking storage locations…"
msgstr "جارٍ التحقق من مواقع التخزين…"

msgid "Storage locations are unavailable."
msgstr "مواقع التخزين غير متاحة."

msgid "Storage information is incomplete; mount actions are unavailable."
msgstr "معلومات التخزين غير مكتملة؛ إجراءات التركيب غير متاحة."

msgid "Storage information is incomplete; removable-volume actions are unavailable."
msgstr "معلومات التخزين غير مكتملة؛ إجراءات وحدات التخزين القابلة للإزالة غير متاحة."

msgid "No removable volumes or mounted network locations."
msgstr "لا توجد وحدات تخزين قابلة للإزالة أو مواقع شبكة مركّبة."

msgid "Storage locations are up to date."
msgstr "معلومات مواقع التخزين محدّثة."

msgid "Unable to read storage locations."
msgstr "تعذّرت قراءة مواقع التخزين."

msgid "Storage service is unavailable."
msgstr "خدمة التخزين غير متاحة."

msgid "Storage access was denied."
msgstr "رُفض الوصول إلى التخزين."

msgid "Storage service is busy."
msgstr "خدمة التخزين مشغولة."

msgid "Unable to start the storage operation."
msgstr "تعذّر بدء عملية التخزين."

msgid "Storage operation accepted."
msgstr "قُبل طلب عملية التخزين."

msgid "Storage operation completed."
msgstr "اكتملت عملية التخزين."

msgid "Storage operation was cancelled."
msgstr "أُلغيت عملية التخزين."

msgid "Storage operation outcome is uncertain."
msgstr "نتيجة عملية التخزين غير مؤكدة."

msgid "Mounting volume…"
msgstr "جارٍ تركيب وحدة التخزين…"

msgid "Unmounting location…"
msgstr "جارٍ إلغاء تركيب الموقع…"

msgid "A storage operation is already in progress."
msgstr "توجد عملية تخزين قيد التنفيذ بالفعل."

msgid "Storage authorization was denied."
msgstr "رُفض الإذن بعملية التخزين."

msgid "Storage information is incomplete; refresh and try again."
msgstr "معلومات التخزين غير مكتملة. حدّثها وحاول مجددًا."

msgid "This storage device changed. Refresh and try again."
msgstr "تغيّر جهاز التخزين هذا. حدّث المعلومات وحاول مجددًا."

msgid "This filesystem is not supported for mounting."
msgstr "تركيب نظام الملفات هذا غير مدعوم."

msgid "This volume is already mounted."
msgstr "وحدة التخزين هذه مركّبة بالفعل."

msgid "This location is managed by another service."
msgstr "تدير خدمة أخرى هذا الموقع."

msgid "A mount location is unavailable."
msgstr "موقع التركيب غير متاح."

msgid "Storage authorization is unavailable."
msgstr "إذن التخزين غير متاح."

msgid "The storage operation failed."
msgstr "فشلت عملية التخزين."

msgid "Mount"
msgstr "تركيب"

msgid "Unmount"
msgstr "إلغاء التركيب"

msgid "Confirm unmount"
msgstr "تأكيد إلغاء التركيب"

msgid "Cancel"
msgstr "إلغاء"

msgid "Connect to SFTP"
msgstr "الاتصال عبر SFTP"

msgid "Hide SFTP form"
msgstr "إخفاء نموذج SFTP"

msgid "Server name or address"
msgstr "اسم الخادم أو عنوانه"

msgid "Server address"
msgstr "عنوان الخادم"

msgid "Username (optional)"
msgstr "اسم المستخدم (اختياري)"

msgid "Username"
msgstr "اسم المستخدم"

msgid "Remote folder (optional)"
msgstr "المجلد البعيد (اختياري)"

msgid "Remote folder"
msgstr "المجلد البعيد"

msgid "Connect"
msgstr "اتصال"

msgid "Enter a server name or address."
msgstr "أدخل اسم الخادم أو عنوانه."

msgid "Confirm disconnect"
msgstr "تأكيد قطع الاتصال"

msgid "Disconnect"
msgstr "قطع الاتصال"

msgid "Network service is unavailable."
msgstr "خدمة الشبكة غير متاحة."

msgid "Unable to start the network operation."
msgstr "تعذّر بدء عملية الشبكة."

msgid "Connecting to SFTP location…"
msgstr "جارٍ الاتصال بموقع SFTP…"

msgid "Disconnecting network location…"
msgstr "جارٍ قطع الاتصال بموقع الشبكة…"

msgid "Network location disconnected."
msgstr "تم قطع الاتصال بموقع الشبكة."

msgid "Network location connected."
msgstr "تم الاتصال بموقع الشبكة."

msgid "Network connection was cancelled."
msgstr "تم إلغاء الاتصال بالشبكة."

msgid "Network operation outcome is uncertain."
msgstr "نتيجة عملية الشبكة غير مؤكدة."

msgid "Check the server address and try again."
msgstr "تحقق من عنوان الخادم وحاول مجددًا."

msgid "SFTP support is unavailable."
msgstr "دعم SFTP غير متاح."

msgid "Unable to start the network mount service."
msgstr "تعذّر بدء خدمة تركيب الشبكة."

msgid "Could not connect to the SFTP server."
msgstr "تعذّر الاتصال بخادم SFTP."

msgid "Could not disconnect the network location."
msgstr "تعذّر قطع الاتصال بموقع الشبكة."

msgid "The network operation failed."
msgstr "فشلت عملية الشبكة."

msgid "Port (default 22)"
msgstr "المنفذ (الافتراضي 22)"

msgid "Port"
msgstr "المنفذ"

msgid "Enter a valid port from 1 to 65535."
msgstr "أدخل رقم منفذ صالحًا من 1 إلى 65535."

msgid "Sort by name"
msgstr "ترتيب حسب الاسم"

msgid "Name (ascending)"
msgstr "الاسم (تصاعديًا)"

msgid "Name (descending)"
msgstr "الاسم (تنازليًا)"

msgid "Enter a file name or select a file."
msgstr "أدخل اسم ملف أو اختر ملفًا."

msgid "This file name cannot be represented on this system."
msgstr "لا يمكن تمثيل اسم الملف هذا على هذا النظام."

msgid "No file with that name exists in this folder."
msgstr "لا يوجد ملف بهذا الاسم في هذا المجلد."

msgid "Unable to check the selected file."
msgstr "تعذّر التحقق من الملف المحدد."

msgid "File name entered. Choose Open to check it."
msgstr "تم إدخال اسم الملف. اختر فتح للتحقق منه."
