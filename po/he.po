msgid "Choose a file"
msgstr "בחירת קובץ"

msgid "Choose files"
msgstr "בחירת קבצים"

msgid "Selected files: %s"
msgstr "קבצים שנבחרו: %s"

msgid "Selected files"
msgstr "קבצים שנבחרו"

msgid "Select at least one file."
msgstr "יש לבחור קובץ אחד לפחות."

msgid "Choose a folder"
msgstr "בחירת תיקייה"

msgid "Select folder"
msgstr "בחירת תיקייה"

msgid "The current folder will be returned."
msgstr "התיקייה הנוכחית תוחזר."

msgid "Save file"
msgstr "שמירת קובץ"

msgid "Save"
msgstr "שמירה"

msgid "File name"
msgstr "שם הקובץ"

msgid "Enter a name for the file to save."
msgstr "יש להזין שם לקובץ לשמירה."

msgid "File name copied from the selection."
msgstr "שם הקובץ הועתק מהבחירה."

msgid "Enter a file name."
msgstr "יש להזין שם קובץ."

msgid "Enter a file name without a folder path."
msgstr "יש להזין שם קובץ ללא נתיב תיקייה."

msgid "The file name is too long."
msgstr "שם הקובץ ארוך מדי."

msgid "Unable to check the target file: %s"
msgstr "לא ניתן לבדוק את קובץ היעד: %s"

msgid "Unable to check the target file."
msgstr "לא ניתן לבדוק את קובץ היעד."

msgid "A folder with this name already exists."
msgstr "כבר קיימת תיקייה בשם הזה."

msgid "A file named “%s” already exists. Replace it?"
msgstr "כבר קיים קובץ בשם „%s”. להחליף אותו?"

msgid "Replace existing file?"
msgstr "להחליף את הקובץ הקיים?"

msgid "Replace"
msgstr "החלפה"

msgid "Unable to show the overwrite confirmation."
msgstr "לא ניתן להציג אישור להחלפה."

msgid "Up"
msgstr "למעלה"

msgid "Home"
msgstr "תיקיית הבית"

msgid "Loading folder…"
msgstr "התיקייה נטענת…"

msgid "Search files"
msgstr "חיפוש קבצים"

msgid "Filter files"
msgstr "סינון קבצים"

msgid "MIME type filters are not applied yet."
msgstr "מסנני MIME עדיין לא מוחלים."

msgid "Show hidden files"
msgstr "הצגת קבצים מוסתרים"

msgid "No file selected"
msgstr "לא נבחר קובץ"

msgid "Open"
msgstr "פתיחה"

msgid "Choose an absolute directory path."
msgstr "יש לבחור נתיב מוחלט לתיקייה."

msgid "File selected. Choose Open to return it."
msgstr "הקובץ נבחר. יש לבחור בפתיחה כדי לאשר אותו."

msgid "Select a file first."
msgstr "יש לבחור קובץ תחילה."

msgid "This folder is empty."
msgstr "התיקייה ריקה."

msgid "Unable to read this folder."
msgstr "לא ניתן לקרוא את התיקייה."

msgid "Unable to read this folder: %s"
msgstr "לא ניתן לקרוא את התיקייה: %s"

msgid "No matching files."
msgstr "לא נמצאו קבצים תואמים."

msgid "Locations"
msgstr "מיקומים"

msgid "Refresh"
msgstr "רענון"

msgid "Checking storage locations…"
msgstr "מיקומי האחסון נבדקים…"

msgid "Storage locations are unavailable."
msgstr "מיקומי האחסון אינם זמינים."

msgid "Storage information is incomplete; mount actions are unavailable."
msgstr "פרטי האחסון אינם מלאים; פעולות העיגון אינן זמינות."

msgid "Storage information is incomplete; removable-volume actions are unavailable."
msgstr "פרטי האחסון אינם מלאים; פעולות עבור אמצעי אחסון נשלפים אינן זמינות."

msgid "No removable volumes or mounted network locations."
msgstr "לא נמצאו אמצעי אחסון נשלפים או מיקומי רשת מעוגנים."

msgid "Storage locations are up to date."
msgstr "פרטי מיקומי האחסון מעודכנים."

msgid "Unable to read storage locations."
msgstr "לא ניתן לקרוא את מיקומי האחסון."

msgid "Storage service is unavailable."
msgstr "שירות האחסון אינו זמין."

msgid "Storage access was denied."
msgstr "הגישה לאחסון נדחתה."

msgid "Storage service is busy."
msgstr "שירות האחסון עסוק."

msgid "Unable to start the storage operation."
msgstr "לא ניתן להתחיל את פעולת האחסון."

msgid "Storage operation accepted."
msgstr "בקשת פעולת האחסון התקבלה."

msgid "Storage operation completed."
msgstr "פעולת האחסון הושלמה."

msgid "Storage operation was cancelled."
msgstr "פעולת האחסון בוטלה."

msgid "Storage operation outcome is uncertain."
msgstr "תוצאת פעולת האחסון אינה ודאית."

msgid "Mounting volume…"
msgstr "אמצעי האחסון מעוגן…"

msgid "Unmounting location…"
msgstr "המיקום מנותק…"

msgid "A storage operation is already in progress."
msgstr "פעולת אחסון כבר מתבצעת."

msgid "Storage authorization was denied."
msgstr "הרשאת האחסון נדחתה."

msgid "Storage information is incomplete; refresh and try again."
msgstr "פרטי האחסון אינם מלאים. יש לרענן ולנסות שוב."

msgid "This storage device changed. Refresh and try again."
msgstr "התקן האחסון השתנה. יש לרענן ולנסות שוב."

msgid "This filesystem is not supported for mounting."
msgstr "מערכת הקבצים הזו אינה נתמכת לעיגון."

msgid "This volume is already mounted."
msgstr "אמצעי האחסון הזה כבר מעוגן."

msgid "This location is managed by another service."
msgstr "השירות שמנהל את המיקום הזה הוא שירות אחר."

msgid "A mount location is unavailable."
msgstr "מיקום העיגון אינו זמין."

msgid "Storage authorization is unavailable."
msgstr "הרשאת האחסון אינה זמינה."

msgid "The storage operation failed."
msgstr "פעולת האחסון נכשלה."

msgid "Mount"
msgstr "עיגון"

msgid "Unmount"
msgstr "ניתוק"

msgid "Confirm unmount"
msgstr "אישור ניתוק"

msgid "Cancel"
msgstr "ביטול"

msgid "Connect to SFTP"
msgstr "התחברות באמצעות SFTP"

msgid "Hide SFTP form"
msgstr "הסתרת טופס SFTP"

msgid "Server name or address"
msgstr "שם השרת או כתובתו"

msgid "Server address"
msgstr "כתובת השרת"

msgid "Username (optional)"
msgstr "שם משתמש (לא חובה)"

msgid "Username"
msgstr "שם משתמש"

msgid "Remote folder (optional)"
msgstr "תיקייה מרוחקת (לא חובה)"

msgid "Remote folder"
msgstr "תיקייה מרוחקת"

msgid "Connect"
msgstr "התחברות"

msgid "Enter a server name or address."
msgstr "יש להזין שם שרת או כתובת."

msgid "Confirm disconnect"
msgstr "אישור ניתוק"

msgid "Disconnect"
msgstr "ניתוק"

msgid "Network service is unavailable."
msgstr "שירות הרשת אינו זמין."

msgid "Unable to start the network operation."
msgstr "לא ניתן להתחיל את פעולת הרשת."

msgid "Connecting to SFTP location…"
msgstr "מתחבר למיקום SFTP…"

msgid "Disconnecting network location…"
msgstr "מנתק את מיקום הרשת…"

msgid "Network location disconnected."
msgstr "הניתוק ממיקום הרשת הושלם."

msgid "Network location connected."
msgstr "החיבור למיקום הרשת הושלם."

msgid "Network connection was cancelled."
msgstr "החיבור לרשת בוטל."

msgid "Network operation outcome is uncertain."
msgstr "תוצאת פעולת הרשת אינה ודאית."

msgid "Check the server address and try again."
msgstr "יש לבדוק את כתובת השרת ולנסות שוב."

msgid "SFTP support is unavailable."
msgstr "תמיכה ב־SFTP אינה זמינה."

msgid "Unable to start the network mount service."
msgstr "לא ניתן להפעיל את שירות עיגון הרשת."

msgid "Could not connect to the SFTP server."
msgstr "החיבור לשרת SFTP נכשל."

msgid "Could not disconnect the network location."
msgstr "לא ניתן לנתק את מיקום הרשת."

msgid "The network operation failed."
msgstr "פעולת הרשת נכשלה."

msgid "Port (default 22)"
msgstr "פורט (ברירת מחדל 22)"

msgid "Port"
msgstr "פורט"

msgid "Enter a valid port from 1 to 65535."
msgstr "יש להזין מספר פורט תקין בין 1 ל־65535."

msgid "Sort by name"
msgstr "מיון לפי שם"

msgid "Name (ascending)"
msgstr "שם (בסדר עולה)"

msgid "Name (descending)"
msgstr "שם (בסדר יורד)"
